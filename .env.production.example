
# MachineDoctor production configuration template
# Placeholder values only. Never commit real credentials.

ENVIRONMENT=production

# PostgreSQL
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/machinedoctor

# Administrator JWT
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend origin (to be supported by backend CORS configuration)
FRONTEND_ORIGIN=https://your-frontend-domain.example
